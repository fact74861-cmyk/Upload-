# ==============================================================================
# Brag Reels Automation Configuration (config.env)
# Android / Termux Environment
# ==============================================================================

# Core Posting Control
# When DRY_RUN is true, generates video + caption, tests UI but NEVER publishes
DRY_RUN=true

# Set to true only when ready for real live publishing
POST_ENABLED=false

# Trigger a one-time immediate test post
POST_NOW=false

# First live Reel requires manual confirmation immediately before final Publish
FIRST_LIVE_TEST_CONFIRM=true

# Schedule Configuration
POST_TIME="18:00"
TIMEZONE="Asia/Kolkata"
POST_ORDER="oldest-first"

# Video Constraints
TARGET_ASPECT="9:16"
MIN_DURATION=15
MAX_DURATION=25
VIDEO_CODEC="h264"
AUDIO_CODEC="aac"

# Directory Structure (Strictly Android Termux paths - no Windows paths)
PROJECTS_DIR="$HOME/brag-reels/projects"
OUTPUT_DIR="$HOME/brag-reels/output"
ARCHIVE_DIR="$HOME/brag-reels/archive"
FAILED_DIR="$HOME/brag-reels/failed"
LOGS_DIR="$HOME/brag-reels/logs"

# Safety Tripwires
STOP_ON_LOGIN=true
STOP_ON_CAPTCHA=true
STOP_ON_MISSING_ELEMENT=true
SCREENSHOT_ON_FAIL=true

# AI Hinglish Caption Settings
CAPTION_LANGUAGE="Hinglish"
ALLOW_UNSUPPORTED_MEDICAL_CLAIMS=false
