# ==============================================================================
# Brag Reels Android / Termux Configuration (config/default.env)
# ==============================================================================

# Core Automation Controls
DRY_RUN=true
POST_NOW=false
POST_ENABLED=false
FIRST_LIVE_TEST_CONFIRM=true

# Schedule Settings
POST_TIME="18:00"
TIMEZONE="Asia/Kolkata"
POST_ORDER="oldest-first"

# Video Constraints
TARGET_ASPECT="9:16"
MIN_DURATION=15
MAX_DURATION=25
VIDEO_CODEC="h264"
AUDIO_CODEC="aac"

# Directory Structure (Strictly Termux POSIX paths - NO Windows D:\ or C:\)
BASE_DIR="$HOME/brag-reels"
PROJECTS_DIR="$HOME/brag-reels/projects"
OUTPUT_DIR="$HOME/brag-reels/output"
ARCHIVE_DIR="$HOME/brag-reels/archive"
FAILED_DIR="$HOME/brag-reels/failed"
LOGS_DIR="$HOME/brag-reels/logs"
CAPTIONS_DIR="$HOME/brag-reels/captions"

# Safety Tripwires
STOP_ON_LOGIN=true
STOP_ON_CAPTCHA=true
STOP_ON_2FA=true
STOP_ON_MISSING_ELEMENT=true
SCREENSHOT_ON_FAIL=true
ALLOW_UNSUPPORTED_MEDICAL_CLAIMS=false
