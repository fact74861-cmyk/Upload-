# GEMINI_API_KEY: Optional for AI-assisted project analysis & copy enrichment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted on Freebuff Cloud.
APP_URL="MY_APP_URL"

# Freebuff Cloud Reel Pipeline Configuration
POST_ENABLED=false
POST_TIME=18:00
TIMEZONE=Asia/Kolkata
POST_ORDER=oldest-first
DRY_RUN=true
POST_NOW=false
MANUAL_CONFIRM=true

# Configurable Paths
PROJECTS_DIR=$HOME/brag-reels/projects
OUTPUT_DIR=$HOME/brag-reels/output
ARCHIVE_DIR=$HOME/brag-reels/archive
LOG_DIR=$HOME/brag-reels/logs

# Brag Skill Options
BRAG_TONE="modern product launch"
BRAG_VOICE=false
